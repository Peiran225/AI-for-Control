@@ -0,0 +1,261 @@
+import os
+
+import numpy as np
+from scipy.integrate import solve_ivp
+from examples.problem_def_template import config_prototype, problem_prototype
+
+
+class config_NN(config_prototype):
+    def __init__(self, N_states, t1, time_dependent):
+        N_layers = 3
+        N_neurons = 96
+        self.layers = self.build_layers(N_states, time_dependent, N_layers, N_neurons)
+
+        self.random_seeds = {"train": 1234}
+
+        self.ODE_solver = "DOP853"
+        self.data_tol = float(os.environ.get("HJB_NN_TUMOR_DATA_TOL", "1e-2"))
+        self.max_nodes = int(os.environ.get("HJB_NN_TUMOR_MAX_NODES", "5000"))
+        self.max_failures = int(os.environ.get("HJB_NN_TUMOR_MAX_FAILURES", "32"))
+
+        Nt = int(os.environ.get("HJB_NN_TUMOR_TIME_MARCH_STEPS", "40"))
+        self.tseq = np.linspace(0.0, t1, Nt + 1)[1:]
+
+        self.dt = 2e-02
+        self.sigma = 1e-02
+        self.plotdims = [0, 10]
+
+        # Keep the official pipeline, but use a modest default data budget
+        # because the tumor BVP is 43-dimensional and has a nonsmooth limit.
+        self.Ns = {
+            "train": int(os.environ.get("HJB_NN_TUMOR_NS_TRAIN", "128")),
+            "test": int(os.environ.get("HJB_NN_TUMOR_NS_TEST", "128")),
+        }
+
+        batch_size = int(os.environ.get("HJB_NN_TUMOR_BATCH_SIZE", "0"))
+        self.batch_size = None if batch_size <= 0 else batch_size
+        self.Ns_scale = 2
+        self.Ns_cand = 2
+        self.Ns_max = 8192
+        self.conv_tol = 0.5
+        self.max_rounds = int(os.environ.get("HJB_NN_TUMOR_MAX_ROUNDS", "2"))
+        self.min_rounds = int(os.environ.get("HJB_NN_TUMOR_MIN_ROUNDS", "1"))
+        self.weight_A = [10.0] * self.max_rounds
+        self.weight_U = [0.0] * self.max_rounds
+        maxiter = int(os.environ.get("HJB_NN_TUMOR_BFGS_MAXITER", "500"))
+        maxfun = int(os.environ.get("HJB_NN_TUMOR_BFGS_MAXFUN", str(max(1000, 3 * maxiter))))
+        self.BFGS_opts = {
+            "maxiter": [maxiter] * self.max_rounds,
+            "maxfun": [maxfun] * self.max_rounds,
+            "iprint": [int(os.environ.get("HJB_NN_TUMOR_BFGS_IPRINT", "0"))] * self.max_rounds,
+        }
+
+
+class setup_problem(problem_prototype):
+    def __init__(self):
+        self.N_states = 21
+        self.N_controls = 1
+        self.t1 = 10.0
+
+        self.umax = 3.0
+        self.beta_scalar = 0.1
+        self.alpha_scalar = 1.0
+        self.gamma = 20.0
+        self.n0 = 10.0
+        self.M_scalar = 0.5
+
+        x = np.linspace(0.0, 1.0, self.N_states)
+        self.r = 2.0 / (1.0 + 3.0 * x**4)
+        self.phi = 1.0 / (1.0 + x**2)
+        self.M = np.full(self.N_states, self.M_scalar)
+        self.beta = np.full(self.N_states, self.beta_scalar)
+        self.alpha = np.full(self.N_states, self.alpha_scalar)
+
+        # The original code samples X0 from a box. For this population model,
+        # a scalar initial-population family is the stable counterpart used in
+        # the manuscript experiments.
+        self.X0_lb = np.full((self.N_states, 1), 0.5 * self.n0)
+        self.X0_ub = np.full((self.N_states, 1), 2.0 * self.n0)
+
+        # Smooth Hamiltonian minimizer used for BVP/data generation. The hard
+        # argmin is recovered as tau -> 0; the singular blend stabilizes the
+        # dominant near-singular arc of this problem.
+        self.tau = float(os.environ.get("HJB_NN_TUMOR_TAU", "2.0"))
+        schedule_text = os.environ.get("HJB_NN_TUMOR_TAU_SCHEDULE", "10,5,2")
+        self.bvp_tau_schedule = [float(value) for value in schedule_text.split(",") if value.strip()]
+        self.singular_eps = float(os.environ.get("HJB_NN_TUMOR_SINGULAR_EPS", "0.2"))
+        self.singular_tau = float(os.environ.get("HJB_NN_TUMOR_SINGULAR_TAU", "0.2"))
+        self.use_singular_blend = bool(int(os.environ.get("HJB_NN_TUMOR_USE_SINGULAR_BLEND", "0")))
+
+    def make_initial_guess(self, X0):
+        """Initial BVP column consistent with the nonzero terminal gradient."""
+        return np.vstack(
+            (
+                np.asarray(X0, dtype=float).reshape((-1, 1)),
+                self.alpha.reshape((-1, 1)),
+                np.zeros((1, 1)),
+            )
+        )
+
+    def make_initial_mesh_guess(self, X0, horizon):
+        """Build a smooth forward-backward warm start for time marching."""
+        horizon = float(horizon)
+        n_mesh = max(31, int(np.ceil(30.0 * horizon)) + 1)
+        t = np.linspace(0.0, horizon, n_mesh)
+        u = np.full(n_mesh, 1.5, dtype=float)
+        X0 = np.asarray(X0, dtype=float).reshape(-1)
+
+        def fixed_state_rhs(time, state):
+            control = float(np.interp(time, t, u))
+            N = self._safe_N(state)
+            G = np.log1p(np.mean(N))
+            return (self.r - self.phi * control - self.M * G) * N
+
+        for _ in range(30):
+            state_sol = solve_ivp(
+                fixed_state_rhs,
+                (0.0, horizon),
+                X0,
+                t_eval=t,
+                dense_output=True,
+                method="DOP853",
+                rtol=1e-7,
+                atol=1e-9,
+            )
+            N = self._safe_N(state_sol.y)
+
+            def fixed_costate_rhs(time, costate):
+                state = self._safe_N(state_sol.sol(time))
+                control = float(np.interp(time, t, u))
+                G = np.log1p(np.mean(state))
+                a = self.r - self.phi * control - self.M * G
+                coupling = np.sum(self.M * costate * state)
+                return -self.beta - costate * a + coupling / (self.N_states + state.sum())
+
+            costate_sol = solve_ivp(
+                fixed_costate_rhs,
+                (horizon, 0.0),
+                self.alpha,
+                t_eval=t[::-1],
+                method="DOP853",
+                rtol=1e-7,
+                atol=1e-9,
+            )
+            A = costate_sol.y[:, ::-1]
+            candidate = self.U_star(np.vstack((N, A, np.zeros((1, n_mesh))))).reshape(-1)
+            u = 0.8 * u + 0.2 * candidate
+
+        L = self.running_cost(N, u.reshape((1, -1))).reshape(-1)
+        value = np.zeros(n_mesh, dtype=float)
+        for index in range(n_mesh - 2, -1, -1):
+            value[index] = value[index + 1] + 0.5 * (L[index] + L[index + 1]) * (t[index + 1] - t[index])
+        return t, np.vstack((N, A, value.reshape((1, -1))))
+
+    def sample_X0(self, Ns):
+        scales = np.random.uniform(0.5, 2.0, size=(1, Ns))
+        X0 = self.n0 * np.ones((self.N_states, Ns)) * scales
+        if Ns == 1:
+            return X0.flatten()
+        return X0
+
+    def _safe_N(self, N):
+        return np.maximum(N, 1e-10)
+
+    def _G(self, N):
+        return np.log1p(np.mean(self._safe_N(N), axis=0, keepdims=True))
+
+    def _singular_control(self, N):
+        N_safe = self._safe_N(N)
+        G = self._G(N_safe)
+        num = (self.beta[:, None] * (self.r[:, None] - self.M[:, None] * G) * N_safe).sum(axis=0, keepdims=True)
+        den = (self.beta[:, None] * self.phi[:, None] * N_safe).sum(axis=0, keepdims=True)
+        return np.clip(num / np.maximum(den, 1e-12), 0.0, self.umax)
+
+    def U_star(self, X_aug):
+        X_aug = np.asarray(X_aug)
+        if X_aug.ndim == 1:
+            X_aug = X_aug.reshape((-1, 1))
+        N = self._safe_N(X_aug[: self.N_states])
+        A = X_aug[self.N_states : 2 * self.N_states]
+        psi = self.gamma - (self.phi[:, None] * N * A).sum(axis=0, keepdims=True)
+        u_bang = self.umax / (1.0 + np.exp(np.clip(psi / self.tau, -60.0, 60.0)))
+        if not self.use_singular_blend:
+            return np.clip(u_bang, 0.0, self.umax)
+        u_sing = self._singular_control(N)
+        q = 1.0 / (1.0 + np.exp(-np.clip((self.singular_eps - np.abs(psi)) / self.singular_tau, -60.0, 60.0)))
+        return np.clip((1.0 - q) * u_bang + q * u_sing, 0.0, self.umax)
+
+    def make_U_NN(self, A, X):
+        import tensorflow.compat.v1 as tf
+
+        X_safe = tf.maximum(X, 1e-10)
+        phi = tf.constant(self.phi.reshape((-1, 1)), dtype=tf.float32)
+        beta = tf.constant(self.beta.reshape((-1, 1)), dtype=tf.float32)
+        r = tf.constant(self.r.reshape((-1, 1)), dtype=tf.float32)
+        M = tf.constant(self.M.reshape((-1, 1)), dtype=tf.float32)
+
+        psi = self.gamma - tf.reduce_sum(phi * X_safe * A, axis=0, keepdims=True)
+        u_bang = self.umax * tf.sigmoid(-psi / self.tau)
+        if not self.use_singular_blend:
+            return tf.clip_by_value(u_bang, 0.0, self.umax)
+
+        G = tf.log1p(tf.reduce_mean(X_safe, axis=0, keepdims=True))
+        num = tf.reduce_sum(beta * (r - M * G) * X_safe, axis=0, keepdims=True)
+        den = tf.maximum(tf.reduce_sum(beta * phi * X_safe, axis=0, keepdims=True), 1e-12)
+        u_sing = tf.clip_by_value(num / den, 0.0, self.umax)
+        q = tf.sigmoid((self.singular_eps - tf.abs(psi)) / self.singular_tau)
+        return tf.clip_by_value((1.0 - q) * u_bang + q * u_sing, 0.0, self.umax)
+
+    def make_bc(self, X0_in):
+        def bc(X_aug_0, X_aug_T):
+            X0 = X_aug_0[: self.N_states]
+            AT = X_aug_T[self.N_states : 2 * self.N_states]
+            vT = X_aug_T[2 * self.N_states :]
+            return np.concatenate((X0 - X0_in, AT - self.alpha, vT))
+
+        return bc
+
+    def running_cost(self, X, U):
+        X = np.asarray(X)
+        if X.ndim == 1:
+            X = X.reshape((-1, 1))
+        U = np.asarray(U)
+        if U.ndim == 1:
+            U = U.reshape((1, -1))
+        return (self.beta[:, None] * self._safe_N(X)).sum(axis=0, keepdims=True) + self.gamma * U
+
+    def terminal_cost(self, X):
+        X = np.asarray(X)
+        if X.ndim == 1:
+            return float(np.dot(self.alpha, self._safe_N(X)))
+        return (self.alpha[:, None] * self._safe_N(X)).sum(axis=0, keepdims=True)
+
+    def compute_cost(self, t, X, U):
+        L = self.running_cost(X, U)
+        J_running = np.trapz(L.flatten(), t.flatten())
+        return np.array([[float(self.terminal_cost(X[:, -1]) + J_running)]])
+
+    def dynamics(self, t, X, U_fun):
+        U = float(np.clip(U_fun([[t]], X.reshape((-1, 1))).flatten()[0], 0.0, self.umax))
+        N = self._safe_N(X)
+        G = np.log1p(np.mean(N))
+        return (self.r - self.phi * U - self.M * G) * N
+
+    def aug_dynamics(self, t, X_aug):
+        N = self._safe_N(X_aug[: self.N_states])
+        A = X_aug[self.N_states : 2 * self.N_states]
+        U = self.U_star(X_aug)
+
+        G = self._G(N)
